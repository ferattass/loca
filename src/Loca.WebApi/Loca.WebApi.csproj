<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f8ebe243-ba75-4ffa-baea-22522dbfffb1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.18" />

    <!--
      Yalnizca tasarim zamani. "dotnet ef migrations" komutu baslangic
      projesinde bu paketi arar cunku baglanti dizesini ve DI kayitlarini
      buradan okur. PrivateAssets=all sayesinde calisma zamani ciktisina
      girmez ve bu projeye bagimli projelere gecmez.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.18">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loca.Application\Loca.Application.csproj" />
    <ProjectReference Include="..\Loca.Persistence\Loca.Persistence.csproj" />
    <ProjectReference Include="..\Loca.Infrastructure\Loca.Infrastructure.csproj" />
  </ItemGroup>

</Project>
