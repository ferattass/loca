{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",

  "App": {
    "BaseUrl": "http://localhost:5000",
    "WebUrl": "http://localhost:5173"
  },

  "Jwt": {
    "Issuer": "Loca",
    "Audience": "LocaClient",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "Storage": {
    "Path": "uploads",
    "MaxSizeMb": 5
  },

  "Reservation": {
    "LockMinutes": 10,
    "ExtendMinutes": 5,
    "MaxSeatsPerUserPerSession": 6,
    "ExpirySweepSeconds": 30,
    "ExpiryBatchSize": 100
  }
}
