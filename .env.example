# Bu dosya sablondur. Kopyalayip .env olarak kaydet:
#   cp .env.example .env
# .env gitignore'da; gercek deger asla depoya girmez.

# --- Veritabani ---
POSTGRES_DB=loca
POSTGRES_USER=loca_user
POSTGRES_PASSWORD=degistir_beni
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=loca;Username=loca_user;Password=degistir_beni

# --- Redis ---
REDIS_CONNECTION_STRING=redis:6379

# --- JWT ---
# Uretimde en az 32 karakterlik rastgele deger kullan.
JWT_SECRET=gelistirme_ortami_icin_gecici_anahtar_en_az_32_karakter
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# --- E-posta ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@loca.local

# --- Dosya saklama ---
FILE_STORAGE_PATH=/app/uploads
FILE_MAX_SIZE_MB=5

# --- Uygulama adresleri ---
APP_BASE_URL=http://localhost:5000
WEB_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api/v1

# --- Yonetim araclari ---
PGADMIN_EMAIL=admin@loca.local
PGADMIN_PASSWORD=degistir_beni

# --- Is kurallari ---
# Koltuk kilit suresi ve bilet limiti koda gomulmez; testte kisaltilabilsin diye
# buradan okunur. Kararlar ve gerekceleri: docs/01-analiz.md
RESERVATION_LOCK_MINUTES=10
RESERVATION_EXTEND_MINUTES=5
MAX_SEATS_PER_USER_PER_SESSION=6
